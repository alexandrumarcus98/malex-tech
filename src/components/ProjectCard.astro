---
import type { CollectionEntry } from 'astro:content';
import { accentVar, pad2 } from '../utils/accent';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
  as?: 'h2' | 'h3';
}

const { project, index, as: Heading = 'h3' } = Astro.props;
const { title, summary, year, stack } = project.data;
---

<a
  href={`/projects/${project.id}`}
  class="card lift tilt-in group grid gap-8 p-7 sm:p-10 md:grid-cols-[minmax(0,1fr)_auto] md:gap-12"
  style={`--accent:${accentVar(index)}`}
  data-spotlight
>
  <span class="ring hidden md:block" aria-hidden="true"></span>

  <div class="min-w-0 space-y-5">
    <p class="eyebrow">{year} · Case study</p>
    <Heading class="title-lg">{title}</Heading>
    <p class="max-w-2xl text-[16px] leading-relaxed text-ink-2 sm:text-[17px]">{summary}</p>
    <ul class="flex flex-wrap gap-2 pt-1" aria-label="Tech stack">
      {stack.map((tech) => <li class="chip">{tech}</li>)}
    </ul>
  </div>

  <div class="flex items-end justify-between gap-6 md:flex-col md:items-end">
    <span class="arrow-btn" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </span>
    <span class="index-num text-accent par" style="--par:28px" aria-hidden="true">{pad2(index + 1)}</span>
  </div>
</a>
