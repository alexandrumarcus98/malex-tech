---
import type { CollectionEntry } from 'astro:content';
import { accentVar, isoDate } from '../utils/accent';

interface Props {
  note: CollectionEntry<'notes'>;
  index: number;
  as?: 'h2' | 'h3';
}

const { note, index, as: Heading = 'h3' } = Astro.props;
const { title, summary, date, tags } = note.data;
---

<a
  href={`/notes/${note.id}/`}
  class="card lift reveal group flex flex-col gap-4 p-6 sm:flex-row sm:items-center sm:gap-10 sm:p-8"
  style={`--accent:${accentVar(index + 1)}`}
  data-spotlight
>
  <time datetime={date.toISOString()} class="eyebrow shrink-0 sm:w-40">{isoDate(date)}</time>

  <div class="min-w-0 flex-1 space-y-2">
    <Heading class="text-[20px] font-semibold leading-snug tracking-[-0.025em] text-ink sm:text-[24px]">
      {title}
    </Heading>
    <p class="max-w-3xl text-[15.5px] leading-relaxed text-ink-2">{summary}</p>
    {tags.length > 0 && (
      <ul class="flex flex-wrap gap-2 pt-2" aria-label="Tags">
        {tags.map((tag) => <li class="chip">#{tag}</li>)}
      </ul>
    )}
  </div>

  <span class="arrow-btn hidden sm:inline-grid" aria-hidden="true">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
  </span>
</a>
