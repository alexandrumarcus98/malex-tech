---
import '../styles/global.css';
import { SITE } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE.title, description = SITE.description } = Astro.props;
const currentPath = Astro.url.pathname;
const canonicalUrl = new URL(currentPath, Astro.site);

const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(`${href}/`);

const navLinks = [
  { href: '/projects', label: 'Projects' },
  { href: '/notes', label: 'Notes' },
];

const tabs = [
  { href: '/', label: 'Home', icon: 'M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z' },
  { href: '/projects', label: 'Projects', icon: 'M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z' },
  { href: '/notes', label: 'Notes', icon: 'M6 3h9l4 4v14H6zM14 3v5h5M9 13h7M9 17h5' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Rethink+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen antialiased">
    <div class="progress" aria-hidden="true"></div>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-bg">
      Skip to content
    </a>

    <!-- Floating island navigation (centred, iOS-style) -->
    <header class="pointer-events-none fixed inset-x-0 top-0 z-50 flex justify-center px-4 pt-[max(12px,env(safe-area-inset-top))]">
      <nav
        class="island glass pointer-events-auto flex items-center gap-1 rounded-full py-1.5 pl-2 pr-1.5"
        aria-label="Primary"
        data-island
      >
        <a href="/" class="flex items-center gap-2.5 rounded-full py-1 pl-1 pr-3 text-[15px] font-semibold tracking-[-0.02em] text-ink" aria-label={`${SITE.handle} — home`}>
          <span class="grid h-8 w-8 place-items-center rounded-full bg-vermilion text-[13px] font-bold text-[#fffaf1]" aria-hidden="true">M</span>
          <span>{SITE.handle}</span>
        </a>

        <span class="mx-1 hidden h-5 w-px bg-line-2 sm:block" aria-hidden="true"></span>

        <div class="hidden items-center sm:flex">
          {navLinks.map((link) => (
            <a href={link.href} class="nav-link" aria-current={isActive(link.href) ? 'page' : undefined}>
              {link.label}
            </a>
          ))}
          <a href={SITE.github} target="_blank" rel="noopener noreferrer" class="nav-link">
            GitHub <span aria-hidden="true">↗</span>
          </a>
        </div>

        <button
          id="theme-toggle"
          type="button"
          aria-label="Toggle color theme"
          class="icon-btn hover:bg-line"
        >
          <svg class="hidden h-[18px] w-[18px] dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
          </svg>
          <svg class="block h-[18px] w-[18px] dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
          </svg>
        </button>

        <a href={`mailto:${SITE.email}`} class="btn btn-solid btn-sm ml-0.5 hidden sm:inline-flex">Get in touch</a>
      </nav>
    </header>

    <main id="main" class="pb-28 sm:pb-0">
      <slot />
    </main>

    <footer class="wrap pb-32 pt-10 sm:pb-12">
      <div class="grid gap-12 border-t border-line pt-14 md:grid-cols-[1.4fr_1fr_1fr_1.2fr]">
        <div class="space-y-5">
          <a href="/" class="inline-flex items-center gap-2.5 text-[17px] font-semibold tracking-[-0.02em] text-ink">
            <span class="grid h-8 w-8 place-items-center rounded-full bg-vermilion text-[13px] font-bold text-[#fffaf1]" aria-hidden="true">M</span>
            {SITE.handle}
          </a>
          <p class="max-w-xs text-[15px] leading-relaxed text-ink-2">{SITE.tagline}</p>
          <p class="inline-flex items-center gap-2 text-[13.5px] text-ink-2">
            <span class="relative flex h-2 w-2" aria-hidden="true">
              <span class="absolute inline-flex h-full w-full rounded-full bg-sage motion-safe:animate-ping"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-sage"></span>
            </span>
            {SITE.status}
          </p>
        </div>

        <div>
          <h2 class="eyebrow no-dot">Site</h2>
          <ul class="mt-5 space-y-3 text-[15px] text-ink-2">
            <li><a href="/" class="link-u hover:text-ink">Home</a></li>
            <li><a href="/projects" class="link-u hover:text-ink">Projects</a></li>
            <li><a href="/notes" class="link-u hover:text-ink">Notes</a></li>
          </ul>
        </div>

        <div>
          <h2 class="eyebrow no-dot">Elsewhere</h2>
          <ul class="mt-5 space-y-3 text-[15px] text-ink-2">
            <li><a href={SITE.github} target="_blank" rel="noopener noreferrer" class="link-u hover:text-ink">GitHub ↗</a></li>
            {SITE.linkedin && (
              <li><a href={SITE.linkedin} target="_blank" rel="noopener noreferrer" class="link-u hover:text-ink">LinkedIn ↗</a></li>
            )}
          </ul>
        </div>

        <div>
          <h2 class="eyebrow no-dot">Contact</h2>
          <ul class="mt-5 space-y-3 text-[15px] text-ink-2">
            <li><a href={`mailto:${SITE.email}`} class="link-u break-all hover:text-ink">{SITE.email}</a></li>
          </ul>
        </div>
      </div>

      <div class="mt-14 flex flex-col gap-3 text-[13px] text-ink-3 sm:flex-row sm:items-center sm:justify-between">
        <p>© {new Date().getFullYear()} {SITE.name}. Built with Astro, served from the edge.</p>
        <a href="#main" class="link-u hover:text-ink">Back to top ↑</a>
      </div>
    </footer>

    <!-- Mobile tab bar (iOS-style floating, bottom centre) -->
    <nav
      class="glass fixed bottom-[max(14px,env(safe-area-inset-bottom))] left-1/2 z-50 flex -translate-x-1/2 items-center gap-1 rounded-full p-1.5 sm:hidden"
      aria-label="Mobile"
    >
      {tabs.map((tab) => (
        <a href={tab.href} class="tab" aria-current={isActive(tab.href) ? 'page' : undefined}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true">
            <path d={tab.icon} />
          </svg>
          {tab.label}
        </a>
      ))}
      <a href={`mailto:${SITE.email}`} class="tab text-vermilion!">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true">
          <path d="M3 6h18v12H3zM3 7l9 6 9-6" />
        </svg>
        Contact
      </a>
    </nav>

    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });
    </script>

    <script>
      import Lenis from 'lenis';

      // Inertial smooth scrolling (the "glide"). Native scrolling is kept for
      // reduced-motion users; touch devices keep native momentum by default.
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        new Lenis({ autoRaf: true, lerp: 0.1, anchors: true });
      }

      // Island: toggle a compact state once the page scrolls (rAF-throttled, passive).
      const island = document.querySelector<HTMLElement>('[data-island]');
      let scrolled: boolean | null = null;
      let queued = false;
      const sync = () => {
        queued = false;
        const next = window.scrollY > 24;
        if (next !== scrolled) {
          scrolled = next;
          island?.toggleAttribute('data-scrolled', next);
        }
      };
      window.addEventListener(
        'scroll',
        () => {
          if (!queued) {
            queued = true;
            requestAnimationFrame(sync);
          }
        },
        { passive: true },
      );
      sync();

      // Card spotlight: pointer-following glow on fine pointers only.
      if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        document.querySelectorAll<HTMLElement>('[data-spotlight]').forEach((el) => {
          let rect = el.getBoundingClientRect();
          let frame = 0;
          let x = 0;
          let y = 0;
          el.addEventListener('pointerenter', () => {
            rect = el.getBoundingClientRect();
          });
          el.addEventListener('pointermove', (event) => {
            x = event.clientX - rect.left;
            y = event.clientY - rect.top;
            if (!frame) {
              frame = requestAnimationFrame(() => {
                el.style.setProperty('--mx', `${x}px`);
                el.style.setProperty('--my', `${y}px`);
                frame = 0;
              });
            }
          });
        });
      }
    </script>
  </body>
</html>
