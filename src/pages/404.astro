---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
---

<BaseLayout title={`404 — ${SITE.name}`}>
  <section class="space-y-4 py-12">
    <p class="font-mono text-xs text-zinc-500">404</p>
    <h1 class="text-2xl font-semibold tracking-tight text-zinc-950 dark:text-zinc-50">
      Page not found
    </h1>
    <p class="text-sm text-zinc-600 dark:text-zinc-400">
      That route doesn’t exist. Head back to the overview or browse projects.
    </p>
    <div class="pt-2">
      <a
        href="/"
        class="inline-flex items-center rounded-md border border-zinc-200 bg-white px-4 py-2 text-sm font-medium text-zinc-800 transition hover:border-zinc-400 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-200 dark:hover:border-zinc-600"
      >
        ← Home
      </a>
    </div>
  </section>
</BaseLayout>
