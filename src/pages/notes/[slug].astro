---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/site';
import { accentVar, isoDate, readingMinutes } from '../../utils/accent';

export async function getStaticPaths() {
  const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime()
  );
  return notes.map((note, index) => ({
    params: { slug: note.id },
    props: { note, index },
  }));
}

const { note, index } = Astro.props;
const { Content } = await render(note);
const minutes = readingMinutes(note.body);
---

<BaseLayout title={`${note.data.title} — ${SITE.name}`} description={note.data.summary}>
  <article style={`--accent:${accentVar(index + 1)}`}>
    <header class="relative isolate overflow-hidden">
      <div
        class="pointer-events-none absolute -left-40 -top-40 -z-10 h-[36rem] w-[36rem] bg-[radial-gradient(circle,color-mix(in_oklab,var(--accent)_30%,transparent)_0%,transparent_62%)]"
        aria-hidden="true"
      ></div>
      <div class="wrap pb-14 pt-32 sm:pt-40">
        <div class="mx-auto max-w-[52rem]">
          <a href="/notes" class="btn btn-glass glass btn-sm in" style="--i:0">← Notes</a>
          <p class="eyebrow in mt-12 flex w-fit" style="--i:1">
            <time datetime={note.data.date.toISOString()}>{isoDate(note.data.date)}</time>
            <span aria-hidden="true">·</span>
            <span>{minutes} min read</span>
          </p>
          <h1 class="display in mt-7 text-[clamp(2.25rem,1.3rem+3.6vw,4.5rem)]" style="--i:2">{note.data.title}</h1>
          <p class="in mt-7 text-[18px] leading-relaxed text-ink-2 sm:text-[20px]" style="--i:3">{note.data.summary}</p>
          {note.data.tags.length > 0 && (
            <ul class="in mt-9 flex flex-wrap gap-2" style="--i:4" aria-label="Tags">
              {note.data.tags.map((tag) => <li class="chip">#{tag}</li>)}
            </ul>
          )}
        </div>
      </div>
    </header>

    <div class="wrap">
      <div class="mx-auto max-w-[52rem] border-t border-line pb-20 pt-14">
        <div class="prose prose-site max-w-[44rem]">
          <Content />
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
