---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/site';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={`${project.data.title} — ${SITE.name}`} description={project.data.summary}>
  <article class="space-y-8">
    <div class="space-y-4 border-b border-zinc-200 pb-6 dark:border-zinc-800/80">
      <a href="/projects" class="inline-flex items-center font-mono text-xs text-zinc-500 transition hover:text-zinc-900 dark:hover:text-zinc-100">
        ← Back to projects
      </a>
      <div class="space-y-2">
        <div class="flex items-baseline justify-between gap-4">
          <h1 class="text-2xl font-semibold tracking-tight text-zinc-950 sm:text-3xl dark:text-zinc-50">
            {project.data.title}
          </h1>
          <span class="shrink-0 font-mono text-xs text-zinc-500">{project.data.year}</span>
        </div>
        <p class="text-base leading-relaxed text-zinc-600 dark:text-zinc-400">
          {project.data.summary}
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-2 pt-1">
        {project.data.stack.map((tech) => (
          <span class="rounded border border-zinc-200 bg-zinc-50 px-2 py-0.5 font-mono text-xs text-zinc-600 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-400">
            {tech}
          </span>
        ))}
        {project.data.repo && (
          <a
            href={project.data.repo}
            target="_blank"
            rel="noopener noreferrer"
            class="ml-auto font-mono text-xs text-zinc-700 underline underline-offset-4 hover:text-zinc-950 dark:text-zinc-300 dark:hover:text-white"
          >
            Source ↗
          </a>
        )}
      </div>
    </div>

    <div class="prose prose-zinc max-w-none prose-headings:font-semibold prose-headings:tracking-tight prose-a:underline-offset-4 prose-pre:border prose-pre:border-zinc-200 dark:prose-invert dark:prose-pre:border-zinc-800">
      <Content />
    </div>
  </article>
</BaseLayout>
